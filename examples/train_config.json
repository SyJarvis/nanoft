{
    "model_name": "Qwen/Qwen2.5-0.5B",
    "lora": {
        "r": 16,
        "lora_alpha": 64,
        "lora_dropout": 0.05,
        "target_modules": [
            "q_proj", "k_proj", "v_proj", "o_proj",
            "gate_proj", "up_proj", "down_proj"
        ]
    },
    "training": {
        "num_train_epochs": 3,
        "learning_rate": 2e-4,
        "per_device_train_batch_size": 4,
        "per_device_eval_batch_size": 4,
        "gradient_accumulation_steps": 4,
        "warmup_ratio": 0.03,
        "weight_decay": 0.01,
        "logging_steps": 50,
        "save_steps": 500,
        "save_total_limit": 3,
        "max_length": 256
    },
    "data": {
        "data_path": "alpaca_gpt4_data_zh.json",
        "test_size": 0.1
    },
    "output": {
        "output_dir": "./output",
        "adapter_dir": "./output/adapter",
        "merged_dir": "./output/merged"
    }
}
