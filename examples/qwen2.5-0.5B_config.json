{
    "model_name": "Qwen/Qwen2.5-0.5B",
    "lora": {
        "r": 8,
        "lora_alpha": 32,
        "lora_dropout": 0.1,
        "target_modules": [
            "q_proj", "k_proj", "v_proj"
        ]
    },
    "training": {
        "num_train_epochs": 1,
        "learning_rate": 2e-5,
        "per_device_train_batch_size": 8,
        "per_device_eval_batch_size": 4,
        "gradient_accumulation_steps": 1,
        "warmup_ratio": 0,
        "weight_decay": 0.01,
        "logging_steps": 100,
        "save_steps": 500,
        "save_total_limit": 2,
        "max_length": 256
    },
    "data": {
        "data_path": "alpaca_gpt4_data_zh.json",
        "test_size": 0.1
    },
    "output": {
        "output_dir": "./output",
        "adapter_dir": "./output/adapter",
        "merged_dir": "./output/merged"
    }
}
